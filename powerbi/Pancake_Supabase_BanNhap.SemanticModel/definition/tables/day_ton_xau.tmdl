table day_ton_xau
	lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56789

	measure 'Ngày chốt cohort' = MAX(day_ton_xau[ngay_snapshot])
		formatString: dd/MM/yyyy
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56708

	measure 'Tồn xấu ban đầu' = VAR chot = [Ngày chốt cohort] RETURN IF(ISBLANK(chot), BLANK(), CALCULATE(SUM(day_ton_xau[ton_luc_chot]), day_ton_xau[ngay_snapshot] = chot))
		formatString: #,0
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56706

	measure 'SL đẩy cohort' = VAR chot = [Ngày chốt cohort] VAR ds = CALCULATETABLE(VALUES(day_ton_xau[spu_key]), day_ton_xau[ngay_snapshot] = chot) RETURN IF(ISEMPTY(ds) || ISBLANK(chot), BLANK(), CALCULATE(SUM(fact_doanh_thu[so_luong]), REMOVEFILTERS(dim_date), fact_doanh_thu[ngay] > chot, TREATAS(ds, fact_doanh_thu[spu_key])))
		formatString: #,0
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56701

	measure 'DT đẩy cohort' = VAR chot = [Ngày chốt cohort] VAR ds = CALCULATETABLE(VALUES(day_ton_xau[spu_key]), day_ton_xau[ngay_snapshot] = chot) RETURN IF(ISEMPTY(ds) || ISBLANK(chot), BLANK(), CALCULATE(SUM(fact_doanh_thu[order_revenue_vnd]), REMOVEFILTERS(dim_date), fact_doanh_thu[ngay] > chot, TREATAS(ds, fact_doanh_thu[spu_key])))
		formatString: #,0
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56702

	measure 'Tồn xấu còn lại' = VAR ton0 = [Tồn xấu ban đầu] VAR sl = [SL đẩy cohort] RETURN IF(ISBLANK(ton0), BLANK(), MAX(0, ton0 - IF(ISBLANK(sl), 0, sl)))
		formatString: #,0
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56704

	measure 'Số mã cohort' = VAR chot = [Ngày chốt cohort] RETURN IF(ISBLANK(chot), BLANK(), CALCULATE(DISTINCTCOUNT(day_ton_xau[spu_key]), day_ton_xau[ngay_snapshot] = chot))
		formatString: #,0
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56705

	measure 'Trạng thái cohort' = VAR sl = IF(ISBLANK([SL đẩy cohort]), 0, [SL đẩy cohort]) VAR con = [Tồn xấu còn lại] RETURN SWITCH(TRUE(), ISBLANK(con), BLANK(), sl > 0 && con = 0, "Đã đẩy hết lô", sl > 0, "Đang đẩy", "Chưa đẩy")
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56709

	measure 'Nhãn cohort đóng băng' = "Tồn xấu (đã chốt)"
		lineageTag: e0f1a2b3-c4d5-6789-e0f1-a2b3c4d56725

