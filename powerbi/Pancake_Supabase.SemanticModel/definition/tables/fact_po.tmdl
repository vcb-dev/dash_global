table fact_po
	lineageTag: 1a926bd7-551b-4653-87d2-17c127840d0c

	measure 'Hàng đang về' = SUM(fact_po[so_luong_con_thieu])
		formatString: #,0
		lineageTag: 5364ddd6-610d-4ee0-bd32-323dd9f05003

	measure 'SL đặt PO' = SUM(fact_po[so_luong_dat])
		formatString: #,0
		lineageTag: 06ee197e-d800-43af-9fc6-0839c909ea2f

	measure 'SL đã nhận PO' = SUM(fact_po[so_luong_da_nhan])
		formatString: #,0
		lineageTag: 4e2337ab-6283-461b-81c4-dab8f3c87772

	measure 'Số dòng PO' = COUNTROWS(fact_po)
		formatString: #,0
		lineageTag: d93081ac-e795-41dd-ac6e-3e0342717c38

	measure 'Số PO' = DISTINCTCOUNT(fact_po[ma_po])
		formatString: #,0
		lineageTag: 5ba8e420-e897-4a2b-84ac-3936eda5329f

	measure 'Số ngày tới ETA' = VAR eta = MAX(fact_po[han_giao]) RETURN IF(ISBLANK(eta), BLANK(), DATEDIFF(TODAY(), eta, DAY))
		formatString: #,0
		lineageTag: a1c4e8f2-3b5d-4e7a-9c1f-2d6b8a0e4f71

	measure 'Gợi ý' = VAR pk = SELECTEDVALUE(dim_spu[phan_khuc]) VAR po = [Hàng đang về] VAR gt = [Giá trị tồn cuối kỳ] RETURN SWITCH(TRUE(), pk = "Bán chạy" && po > 0, "Ưu tiên nhận/QC/lên kệ", pk = "Bán chạy", "Giữ stock — cân nhắc đặt nếu thiếu", pk = "Tồn xấu" && gt > 0, "Xả tồn / cắt đặt", pk = "Bán chậm" && gt > 0, "Theo dõi — hạn chế nhập", pk = "Bán thường", "Duy trì tồn tiêu chuẩn", BLANK())
		lineageTag: b2d5f9a3-4c6e-5f8b-0d2a-3e7c9b1f5a82

	measure 'SL quá hạn' = CALCULATE([Hàng đang về], fact_po[han_giao] < TODAY())
		formatString: #,0
		lineageTag: d4f7b1c5-6e8a-710d-2f4c-5a9e1d3b7c04

	measure 'SL sắp đến hạn' = CALCULATE([Hàng đang về], fact_po[han_giao] >= TODAY() && fact_po[han_giao] <= TODAY() + 7)
		formatString: #,0
		lineageTag: e5a8c2d6-7f9b-821e-3a5d-6b0f2e4c8d15

	measure 'SL còn hạn' = CALCULATE([Hàng đang về], fact_po[han_giao] > TODAY() + 7)
		formatString: #,0
		lineageTag: f6b9d3e7-80ac-932f-4b6e-7c1a3f5d9e26

	measure 'Dòng quá hạn' = CALCULATE([Số dòng PO], fact_po[han_giao] < TODAY())
		formatString: #,0
		lineageTag: a7c0e4f8-91bd-043a-5c7f-8d2b4a6e0f37

