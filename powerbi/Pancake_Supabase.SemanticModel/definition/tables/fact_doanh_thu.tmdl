table fact_doanh_thu
	lineageTag: 7ce6ce4e-3bca-440a-921e-f1c7de2a9cd8

	measure 'Doanh thu' = SUM(fact_doanh_thu[order_revenue_vnd])
		formatString: #,0
		lineageTag: 3c3678e0-41ef-4ddd-9157-4f0bd65f2b87

	measure 'Doanh thu trước hoàn' = SUM(fact_doanh_thu[revenue_truoc_hoan])
		formatString: #,0
		lineageTag: 80ad91dd-c92d-4911-8750-c74b433362eb

	measure 'Doanh thu hoàn' = SUM(fact_doanh_thu[doanh_thu_hoan])
		formatString: #,0
		lineageTag: 5d257f46-6a48-4a4f-a505-d70733f8208c

	measure 'Đơn chốt' = SUM(fact_doanh_thu[don_chot])
		formatString: #,0
		lineageTag: 7e961e20-80c4-4084-87c5-7d62390d52ae

	measure 'Số lượng bán' = SUM(fact_doanh_thu[so_luong])
		formatString: #,0
		lineageTag: a8325969-891d-4d24-a9f4-3b6014c2076a

	measure 'Giá trị TB/đơn' = DIVIDE([Doanh thu], [Đơn chốt])
		formatString: #,0
		lineageTag: 26164ef6-7772-481a-bf5a-374e96dc98ce

	measure 'Doanh thu MTD' = TOTALMTD([Doanh thu], dim_date[ngay])
		formatString: #,0
		lineageTag: 0e5dfc89-f0a2-4cf7-ab58-87e10e849460

	measure 'Đơn chốt MTD' = TOTALMTD([Đơn chốt], dim_date[ngay])
		formatString: #,0
		lineageTag: bce06143-f06d-445e-a5bb-cc2a17161542

	measure 'Tỷ trọng doanh thu' = DIVIDE([Doanh thu], CALCULATE([Doanh thu], ALLSELECTED(dim_spu)))
		formatString: 0.0%
		lineageTag: 5093b2a0-4838-4913-a047-84f51b5cce18

	measure '⚠ DT mã trung gian' = CALCULATE([Doanh thu], dim_spu[phan_khuc] = "Mã trung gian")
		formatString: #,0
		lineageTag: e9f1a2b3-4c5d-6e7f-8091-a2b3c4d5e6f7

	measure 'Benchmark DT/ngày' = AVERAGEX(ALLSELECTED(dim_date[ngay]), CALCULATE([Doanh thu]))
		formatString: #,0
		lineageTag: be12ad76-264a-4c8a-8eaa-076fc8048622

