# Copy from pancake/.env or set here
SUPABASE_DB_URL=postgresql://...
DB_SCHEMA=global

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match authorized redirect URI in Google Console
GOOGLE_REDIRECT_URI=http://localhost:3847/auth/google/callback

# Comma-separated emails allowed to access (empty = any Google account)
ALLOWED_EMAILS=

# Random secret for signed session cookie
SESSION_SECRET=doi-chuoi-nay-thanh-random-dai
PORT=3847
